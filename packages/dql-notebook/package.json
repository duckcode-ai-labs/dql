  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zlens/core": "workspace:*",
    "@zlens/connectors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
