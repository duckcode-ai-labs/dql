{
  "name": "@zlens/notebook",
  "version": "0.2.0",
  "description": "Notebook document model and execution helpers for ZLens",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
