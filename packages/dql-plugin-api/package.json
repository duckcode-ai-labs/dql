{
  "name": "@zlens/plugin-api",
  "version": "0.2.0",
  "description": "Stable plugin contracts for DQL \u2014 connectors, chart renderers, governance rule packs. Frozen at v1.0.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai-labs/zlens.git",
    "directory": "packages/dql-plugin-api"
  },
  "homepage": "https://github.com/duckcode-ai-labs/zlens",
  "bugs": {
    "url": "https://github.com/duckcode-ai-labs/zlens/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector": {
      "types": "./dist/connector.d.ts",
      "import": "./dist/connector.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./governance": {
      "types": "./dist/governance.d.ts",
      "import": "./dist/governance.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "prepack": "node ../../scripts/package-license-files.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
