{
  "name": "@zlens/agent",
  "version": "0.2.0",
  "description": "ZLens agent: knowledge graph, Skills, block-first answer loop, and pluggable LLM providers (Claude / OpenAI / Gemini / Ollama)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "test": "node ./scripts/test-lanes.mjs",
    "test:heavy": "node ./scripts/test-lanes.mjs --lane=heavy",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "prepack": "node ../../scripts/package-license-files.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai-labs/zlens.git",
    "directory": "packages/dql-agent"
  },
  "homepage": "https://github.com/duckcode-ai-labs/zlens",
  "bugs": {
    "url": "https://github.com/duckcode-ai-labs/zlens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zlens/core": "workspace:*",
    "@zlens/governance": "workspace:*",
    "@zlens/project": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
