{
  "name": "@zlens/governance",
  "version": "0.2.1",
  "description": "ZLens governance: block testing, certification, cost estimation, and access policies",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "prepack": "node ../../scripts/package-license-files.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai-labs/zlens.git",
    "directory": "packages/dql-governance"
  },
  "homepage": "https://github.com/duckcode-ai-labs/zlens",
  "bugs": {
    "url": "https://github.com/duckcode-ai-labs/zlens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zlens/core": "workspace:*",
    "@zlens/project": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
