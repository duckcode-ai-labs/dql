{
  "name": "@zlens/cli",
  "version": "0.1.0",
  "description": "Public CLI for ZLens: parsing, formatting, testing, and certifying DQL blocks",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "zlens": "./dist/index.js",
    "dql": "./dist/dql-alias.js"
  },
  "exports": {
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "pnpm --filter @zlens/notebook-app build && rm -rf dist tsconfig.tsbuildinfo && tsc -b && node ./scripts/copy-runtime-assets.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:offline": "node scripts/test-offline.mjs",
    "bench:manifest": "tsx bench/manifest-bench.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build",
    "prepack": "node ../../scripts/package-license-files.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai-labs/zlens.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/duckcode-ai-labs/zlens",
  "bugs": {
    "url": "https://github.com/duckcode-ai-labs/zlens/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@zlens/agent": "workspace:*",
    "@zlens/dql-compiler": "workspace:*",
    "@zlens/connectors": "workspace:*",
    "@zlens/core": "workspace:*",
    "@zlens/governance": "workspace:*",
    "@zlens/mcp": "workspace:*",
    "@zlens/notebook": "workspace:*",
    "@zlens/project": "workspace:*",
    "@zlens/slack": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "isomorphic-git": "^1.27.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^6.44.0"
  },
  "devDependencies": {
    "@zlens/notebook-app": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
