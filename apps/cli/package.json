{
  "name": "@duckcodeailabs/dql-cli",
  "version": "1.17.3",
  "description": "Public CLI for parsing, formatting, testing, and certifying DQL blocks",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dql": "./dist/index.js"
  },
  "exports": {
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "pnpm --filter @duckcodeailabs/dql-notebook-app build && rm -rf dist tsconfig.tsbuildinfo && tsc -b && node ./scripts/copy-runtime-assets.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:offline": "node scripts/test-offline.mjs",
    "bench:manifest": "tsx bench/manifest-bench.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai/dql.git",
    "directory": "apps/cli"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@duckcodeailabs/dql-agent": "workspace:*",
    "@duckcodeailabs/dql-compiler": "workspace:*",
    "@duckcodeailabs/dql-connectors": "workspace:*",
    "@duckcodeailabs/dql-core": "workspace:*",
    "@duckcodeailabs/dql-governance": "workspace:*",
    "@duckcodeailabs/dql-mcp": "workspace:*",
    "@duckcodeailabs/dql-notebook": "workspace:*",
    "@duckcodeailabs/dql-project": "workspace:*",
    "@duckcodeailabs/dql-slack": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "isomorphic-git": "^1.27.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^6.44.0"
  },
  "devDependencies": {
    "@duckcodeailabs/dql-notebook-app": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
