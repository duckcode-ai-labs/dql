// dql-format: 1

block "top_players_by_total_points" {
  domain = "nba"
  type = "custom"
  status = "certified"
  description = "Top players by summed points across games dated in a calendar-year range, with the number of game records. One row per player name."
  tags = ["nba", "players", "scoring", "ranking"]
  owner = "sports-analytics@nba.test"
  pattern = "ranking"
  grain = "player_name"
  entities = ["player", "game"]
  outputs = ["player_name", "total_points", "games_played"]
  dimensions = ["player_name"]
  allowedFilters = ["season_start", "season_end", "top_n"]
  parameterPolicy {
    season_start = "dynamic"
    season_end = "dynamic"
    top_n = "dynamic"
  }
  sourceSystems = ["dbt:player_game_stats"]
  llmContext = "Ranks players by total points over games dated between season_start and season_end (calendar years), returning top_n rows. Groups by player name."
  reviewCadence = "monthly"
  examples = [{ question = "Who are the top players by total points in 2016 and 2017?" }]
  params {
    season_start = 2016
    season_end = 2017
    top_n = 5
  }
  query = """
    SELECT
      player_name,
      SUM(pts) AS total_points,
      COUNT(DISTINCT game_id) AS games_played
    FROM dev.player_game_stats
    WHERE CAST(strftime('%Y', game_date) AS INTEGER) BETWEEN ${season_start} AND ${season_end}
      AND player_name IS NOT NULL
    GROUP BY player_name
    ORDER BY total_points DESC, player_name ASC
    LIMIT ${top_n}
  """
  visualization {
    chart = "table"
  }
  tests {
    assert row_count > 0
  }
}
