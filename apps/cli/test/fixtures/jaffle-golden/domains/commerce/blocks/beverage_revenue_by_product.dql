// dql-format: 1

block "beverage_revenue_by_product" {
  domain = "commerce"
  type = "custom"
  status = "certified"
  description = "Beverage product revenue and item count. One row per beverage product."
  tags = ["beverage", "product", "revenue", "ranking"]
  owner = "analytics@jaffle.shop"
  terms = ["Revenue", "Beverage"]
  pattern = "ranking"
  grain = "one row per beverage product"
  entities = ["order_item", "product"]
  outputs = ["product_name", "beverage_revenue", "items_sold"]
  dimensions = ["product_name"]
  sourceSystems = ["dbt:order_items", "dbt:products"]
  llmContext = "Use for the highest-revenue beverage products. Beverage revenue is SUM(dev.order_items.product_price), excluding tax. The products alias is intentional so the beverage predicate is unambiguous."
  reviewCadence = "monthly"
  examples = [{ question = "Which beverage products generate the most revenue?" }, { question = "What are the top drinks by revenue?" }]
  query = """
    SELECT
      products.product_name,
      SUM(order_items.product_price) AS beverage_revenue,
      COUNT(*) AS items_sold
    FROM dev.order_items AS order_items
    JOIN dev.products AS products
      ON order_items.product_id = products.product_id
    WHERE products.is_drink_item = true
    GROUP BY 1
    ORDER BY beverage_revenue DESC, products.product_name
  """
  visualization {
    chart = "bar"
  }
  tests {
    assert row_count > 0
  }
}
