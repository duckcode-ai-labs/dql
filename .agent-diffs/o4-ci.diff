diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index c9e6a8a7..c05b209c 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -158,13 +158,15 @@ jobs:
       - name: run benchmark (gates cold <30s, warm <2s)
         run: DQL_CLI="node $PWD/apps/cli/dist/index.js" node scripts/bench/run-bench.mjs /tmp/stress

-  # --- E2E Playwright (notebook happy path) ---
-  # Runs the starter-project path in a headless browser. On PRs that don't
-  # touch the notebook app, we skip to keep CI fast.
+  # --- Real-browser E2E (notebook smoke journeys) ---
+  # Drives the BUILT `dql notebook` CLI in headless Chromium on every PR and
+  # push (AGENTS.md: Vite-only proof is not acceptance). The suite's global
+  # setup seeds a temp copy of the jaffle fixture and starts the server.
+  # The self-hosted runner has no sudo, so Chromium is installed without
+  # --with-deps; the runner image must already carry the browser libraries.
   e2e:
     name: playwright e2e
-    runs-on: ubuntu-latest
-    if: github.event_name == 'push' || contains(github.event.pull_request.changed_files, 'apps/dql-notebook')
+    runs-on: [self-hosted, dql-runner]
     steps:
       - uses: actions/checkout@v4
       - uses: pnpm/action-setup@v4
@@ -174,15 +176,25 @@ jobs:
           cache: pnpm
       - run: pnpm install --frozen-lockfile
       - run: pnpm build
-      - run: pnpm -F @duckcodeailabs/dql-notebook-app exec playwright install --with-deps chromium
-        continue-on-error: true
+      - run: pnpm -F @duckcodeailabs/dql-notebook-app exec playwright install chromium
       - run: pnpm -F @duckcodeailabs/dql-notebook-app test:e2e
-        continue-on-error: true  # gate hardens to `false` once the suite lands
+        env:
+          CI: "true"
+          E2E_SKIP_BUILD: "1"
+      - name: upload Playwright report
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: playwright-report
+          path: |
+            apps/dql-notebook/playwright-report/
+            apps/dql-notebook/test-results/
+          retention-days: 7

   # --- summary gate for branch protection ---
   ci-ok:
     name: ci-ok
     runs-on: ubuntu-latest
-    needs: [build-and-test, scaffold-smoke, docs, format-check, golden-eval]
+    needs: [build-and-test, scaffold-smoke, docs, format-check, golden-eval, e2e]
     steps:
       - run: echo "All required CI gates passed."
