{
  "name": "dql",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai/dql.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "release:dry-run": "pnpm build && pnpm test && node ./scripts/release-packages.mjs --dry-run",
    "release:publish": "node ./scripts/release-packages.mjs --publish",
    "test:install:published": "node ./scripts/smoke-cli-install.mjs",
    "release:extension": "pnpm --filter dql-language-support package",
    "perf:scale:unit": "node --test scripts/performance/dql2-scale-fixture.test.mjs",
    "perf:scale": "node scripts/performance/dql2-scale-benchmark.mjs",
    "test:perf:scale": "pnpm build && node scripts/performance/dql2-scale-benchmark.mjs --gate"
  },
  "dependencies": {
    "@duckcodeailabs/dql-cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22.0.0"
    }
  }
}
