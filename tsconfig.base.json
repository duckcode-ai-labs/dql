{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@zlens/core": ["packages/dql-core/src/index.ts"],
      "@zlens/core/format": [
        "packages/dql-core/src/format/index.ts"
      ],
      "@zlens/core/lineage": [
        "packages/dql-core/src/lineage/index.ts"
      ],
      "@zlens/core/artifacts": [
        "packages/dql-core/src/artifacts/index.ts"
      ],
      "@zlens/dql-compiler": ["packages/dql-compiler/src/index.ts"],
      "@zlens/runtime": ["packages/dql-runtime/src/index.ts"],
      "@zlens/charts": ["packages/dql-charts/src/index.ts"],
      "@zlens/dql-lsp": ["packages/dql-lsp/src/index.ts"],
      "@zlens/connectors": ["packages/dql-connectors/src/index.ts"],
      "@zlens/governance": ["packages/dql-governance/src/index.ts"],
      "@zlens/project": ["packages/dql-project/src/index.ts"],
      "@zlens/notebook": ["packages/dql-notebook/src/index.ts"],
      "@zlens/ui": ["packages/dql-ui/src/index.ts"],
      "@zlens/mcp": ["packages/dql-mcp/src/index.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true
  }
}
